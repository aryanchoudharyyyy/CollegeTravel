# Copy to .env.production and replace every example value before deployment.
# Keep the resulting file out of source control and inject secrets through the
# deployment platform's secret manager where possible.
FRONTEND_ORIGIN=https://www.example.com
FRONTEND_URL=https://www.example.com
API_DOMAIN=api.example.com
GATEWAY_BIND_ADDRESS=127.0.0.1

# These defaults describe the single-host Compose topology. Override with
# reachable endpoints if your deployment uses managed services.
EUREKA_URL=http://eureka-server:8761/eureka/
CONFIG_SERVER_URL=http://config-server:8888
CONFIG_REPO_URI=https://github.com/your-org/your-config-repository.git
CONFIG_REPO_BRANCH=main
DB_HOST=postgres-db
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Supply unique production credentials through a secret manager.
DB_USERNAME=replace-me
DB_PASSWORD=replace-me
RABBITMQ_USERNAME=replace-me
RABBITMQ_PASSWORD=replace-me
CONFIG_SERVER_USERNAME=replace-me
CONFIG_SERVER_PASSWORD=replace-me
CONFIG_REPO_USERNAME=replace-me
CONFIG_REPO_PASSWORD=replace-me
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_API_KEY=replace-with-a-long-random-key
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_APP_PASSWORD=replace-me
MAIL_FROM=no-reply@example.com
